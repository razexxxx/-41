@@ -0,0 +1,136 @@
+// main.cpp - точка входа: меню приложения «Питон» (п.1.1.3 ТЗ)
+// Окна: вход игроков / новая игра (игровое окно) / рейтинг / регистрация / справка / выход.
+#include <iostream>
+#include <string>
+
+#include "database.h"
+#include "game_field.h"
+#include "console_io.h"
+
+static std::string promptLine(const std::string& label) {
+    std::cout << label;
+    std::cout.flush();
+    std::string s;
+    if (!std::getline(std::cin, s)) return ""; // EOF -> пустая строка
+    while (!s.empty() && s.back() == '\r') s.pop_back();
+    return s;
+}
+
+// ---------- Окно входа (п.1.1.3: «В окне входа участники вводят логины и пароли») ----------
+static User* loginWindow(Database& db, int playerNo) {
+    std::cout << "\n--- \320\230\320\263\321\200\320\276\320\272 " << playerNo << ": \320\262\321\205\320\276\320\264 \320\262 \321\201\320\270\321\201\321\202\320\265\320\274\321\203 ---\n";
+    for (int attempt = 0; attempt < 3; ++attempt) {
+        std::string login = promptLine("\320\233\320\276\320\263\320\270\320\275: ");
+        std::string pass  = promptLine("\320\237\320\260\321\200\320\276\320\273\321\214: ");
+        if (User* u = db.login(login, pass)) {
+            std::cout << "  OK: " << u->playerName << " (" << u->login << ")\n";
+            return u;
+        }
+        std::cout << "  \320\236\321\210\320\270\320\261\320\272\320\260: \320\275\320\265\320\262\320\265\321\200\320\275\321\213\320\271 \320\273\320\276\320\263\320\270\320\275 \320\270\320\273\320\270 \320\277\320\260\321\200\320\276\320\273\321\214, \320\273\320\270\320\261\320\276 \320\277\320\276\320\273\321\214\320\267\320\276\320\262\320\260\321\202\320\265\320\273\321\214 \320\276\321\202\321\201\321\203\321\202\321\201\321\202\320\262\321\203\320\265\321\202 \320\262 \320\261\320\260\320\267\320\265 USERS\n";
+        std::cout << "  (\320\277\320\276\320\262\321\202\320\276\321\200\320\275\320\260\321\217 \320\277\320\276\320\277\321\213\321\202\320\272\320\260 \320\262\321\205\320\276\320\264\320\260)\n";
+    }
+    return nullptr;
+}
+
+// ---------- Регистрация игрока (заполнение базы USERS) ----------
+static void registerWindow(Database& db) {
+    std::cout << "\n--- \320\240\320\265\320\263\320\270\321\201\321\202\321\200\320\260\321\206\320\270\321\217 \320\270\320\263\321\200\320\276\320\272\320\260 ---\n";
+    std::string login = promptLine("\320\233\320\276\320\263\320\270\320\275 (a-z0-9): ");
+    std::string pass  = promptLine("\320\237\320\260\321\200\320\276\320\273\321\214: ");
+    std::string name  = promptLine("\320\230\320\274\321\217 \320\270\320\263\321\200\320\276\320\272\320\260: ");
+    std::string err;
+    if (db.registerUser(login, pass, name, err)) {
+        db.save();
+        std::cout << "  \320\230\320\263\321\200\320\276\320\272 \320\267\320\260\321\200\320\265\320\263\320\270\321\201\321\202\321\200\320\270\321\200\320\276\320\262\320\260\320\275 (ID_USER=" << db.users().back().idUser << ")\n";
+    } else {
+        std::cout << "  \320\236\321\210\320\270\320\261\320\272\320\260: " << err << "\n";
+    }
+}
+
+// ---------- Окно рейтинга (п.1.1.4: таблица рейтинга, сортировка по очкам) ----------
+static void ratingWindow(const Database& db) {
+    std::cout << "\n---- \320\240\320\265\320\271\321\202\320\270\320\275\320\263 (\321\201\320\276\321\200\321\202\320\270\321\200\320\276\320\262\320\272\320\260 \320\277\320\276 \320\276\321\207\320\272\320\260\320\274) ----\n";
+    auto recs = db.getRatingSorted();
+    if (recs.empty()) {
+        std::cout << "  \320\227\320\260\320\277\320\270\321\201\320\265\320\271 \320\277\320\276\320\272\320\260 \320\275\320\265\321\202 - \321\201\321\213\320\263\321\200\320\260\320\271\321\202\320\265 \320\277\320\260\321\200\321\202\320\270\321\216!\n";
+        return;
+    }
+    std::cout << "  #  LOGIN            SCORE  FOOD  DATE          RESULT\n";
+    int i = 1;
